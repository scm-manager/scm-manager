{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    "tsconfig.json"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "depcheck": {
    },
    "typecheck": {
    },
    "lint": {
    },
    "test": {
      "outputs": ["build/vitest-reports"]
    },
    "ci": {
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build"]
    },
    "serve": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
