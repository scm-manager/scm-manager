{
  "name": "@scm-manager/ui-api",
  "version": "4.0.0-SNAPSHOT",
  "description": "React hook api for the SCM-Manager backend",
  "main": "build/index.js",
  "module": "build/index.mjs",
  "types": "build/index.d.ts",
  "files": [
    "build"
  ],
  "repository": "https://github.com/scm-manager/scm-manager",
  "author": "SCM Team <scm-team@cloudogu.com>",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "tsup ./src/index.ts -d build --format esm,cjs --dts",
    "typecheck": "tsc",
    "lint": "eslint src",
    "test": "vitest",
    "depcheck": "depcheck"
  },
  "peerDependencies": {
    "query-string": "6.14.1",
    "react": "^19.1.1",
    "react-i18next": "11",
    "@tanstack/react-query": "^5.90.6",
    "@tanstack/react-query-devtools": "^5.90.2"
  },
  "devDependencies": {
    "@scm-manager/babel-preset": "^2.13.1",
    "@scm-manager/eslint-config": "^2.18.2",
    "@scm-manager/prettier-config": "^2.12.0",
    "@scm-manager/tsconfig": "^3.0.0-alpha1",
    "@scm-manager/ui-types": "4.0.0-SNAPSHOT",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/react": "^19.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "ci-info": "^4.4.0",
    "fetch-mock": "^7.5.1",
    "minimatch": "^10.0.3",
    "tsup": "^5.12.6",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "gitdiff-parser": "^0.3.1"
  },
  "babel": {
    "presets": [
      "@scm-manager/babel-preset"
    ]
  },
  "prettier": "@scm-manager/prettier-config",
  "eslintConfig": {
    "extends": "@scm-manager/eslint-config",
    "rules": {
      "react/display-name": "off",
      "@typescript-eslint/no-explicit-any": "warn"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}