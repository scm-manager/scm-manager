exports[`Global/TextHitField UnknownSyntaxHighlighting 1`] = `
"<pre>...
<code># LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
# OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
# SOFTWARE.
#

<mark>getent</mark> group scm &gt;/dev/null || groupadd -r scm
<mark>getent</mark> passwd scm &gt;/dev/null || \\
    useradd -r -g scm -M \\
    -s /sbin/nologin -d /var/lib/scm \\
    -c "user for the scm-server process" scm
exit 0

</code></pre>
"
`;

