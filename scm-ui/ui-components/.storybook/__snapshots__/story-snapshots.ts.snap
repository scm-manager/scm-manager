exports[`Global/MarkdownView Links 1`] = `
"<div class="sc-tACje jKhnFF">
<div class="sc-hZpGMz gVQdOK content">
<div>
<h1 id="links">Links</h1>
<p>Show case for different style of markdown links.
Please note that some of the links may not work in storybook,
the story is mostly for checking if the links are rendered correct.</p>
<h2 id="external">External</h2>
<p>External Links should be opened in a new tab: <a href="https://scm-manager.org" target="_blank" rel="noopener noreferrer">external link</a>
</p>
<h2 id="anchor">Anchor</h2>
<p>Anchor Links should be rendered a simple a tag with an href: <a href="/repo/storybook/markdown#sample">anchor link</a>
</p>
<h2 id="protocol">Protocol</h2>
<p>Links with a protocol other than http should be rendered a simple a tag with an href e.g.: <a href="mailto:marvin@hitchhiker.com">mail link</a>
</p>
<h2 id="custom-protocol">Custom Protocol</h2>
<p>Renderers for custom protocols can be added via the "markdown-renderer.link.protocol" extension point: <div style="border: 1px dashed lightgray; padding: 2px;">
<h4>Link: marvin@hitchhiker.com [Protocol: scw]</h4>
<div>children: description of scw link</div>
</div>
</p>
<h2 id="internal">Internal</h2>
<p>Internal links should be rendered by react-router: <a href="/scm/buttons" data-discover="true">internal link</a>
</p>
</div>
</div>
</div>
"
`;

