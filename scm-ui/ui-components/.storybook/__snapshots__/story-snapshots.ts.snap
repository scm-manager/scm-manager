exports[`Components/PreformattedCodeBlock Combination 1`] = `
"<div class="sc-tACje m-6">
  <div class="content">
    <h3 class="is-size-5">Clone the Repository</h3>
    <div class="sc-gsDMPd fhGJJu is-relative">
      <pre><code>git clone https://fancy-scm.url/scm/repo/test/scmm cd scmm</code></pre>
      <button type="button" title="Copy to clipboard" class="button is-default sc-bdvwhi jciKmc is-small">
        <span> <i class="fa fa-clipboard"></i></span>
      </button>
    </div>
    <h3 class="is-size-5">Git hook for commit message validation</h3>
    <div class="sc-gsDMPd fhGJJu is-relative">
      <pre><code>#!/bin/bash

### For this hook to work you need the SCM CLI client (https://scm-manager.org/cli/)
### installed and connected to your SCM Server.

BRANCH_NAME=$(git symbolic-ref --short HEAD)
COMMIT_MSG_FILE=$(cat $1)

scm repo commit-message-check aaa/ultimate-repo $BRANCH_NAME "$COMMIT_MSG_FILE"</code></pre>
      <button type="button" title="Copy to clipboard" class="button is-default sc-bdvwhi jciKmc is-small">
        <span> <i class="fa fa-clipboard"></i></span>
      </button>
    </div>
    <h3 class="is-size-5">Get Remote Changes</h3>
    <div class="sc-gsDMPd fhGJJu is-relative">
      <pre><code>git fetch</code></pre>
      <button type="button" title="Copy to clipboard" class="button is-default sc-bdvwhi jciKmc is-small">
        <span> <i class="fa fa-clipboard"></i></span>
      </button>
    </div>
    <h3 class="is-size-5">Switch Branch</h3>
    <div class="sc-gsDMPd fhGJJu is-relative">
      <pre><code>git checkout feature/something</code></pre>
      <button type="button" title="Copy to clipboard" class="button is-default sc-bdvwhi jciKmc is-small">
        <span> <i class="fa fa-clipboard"></i></span>
      </button>
    </div>
  </div>
</div>
"
`;

