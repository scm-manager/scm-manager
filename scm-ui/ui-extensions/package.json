{
  "name": "@scm-manager/ui-extensions",
  "version": "4.0.0-REACT19-SNAPSHOT",
  "license": "AGPL-3.0-only",
  "private": false,
  "author": "Sebastian Sdorra <sebastian.sdorra@cloudogu.com>",
  "main": "build/index.js",
  "module": "build/index.mjs",
  "types": "build/index.d.ts",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsup ./src/index.ts -d build --format esm,cjs --dts",
    "typecheck": "tsc",
    "lint": "eslint src",
    "test": "vitest",
    "depcheck": "depcheck"
  },
  "dependencies": {
    "react-router-dom": "^7.13.0"
  },
  "peerDependencies": {
    "react": "^19.1.1"
  },
  "devDependencies": {
    "@scm-manager/babel-preset": "^2.13.1",
    "@scm-manager/eslint-config": "^2.18.2",
    "@scm-manager/prettier-config": "^2.12.0",
    "@scm-manager/tsconfig": "^3.0.0-alpha1",
    "@scm-manager/ui-types": "4.0.0-REACT19-SNAPSHOT",
    "@vitest/coverage-v8": "^4.0.18",
    "@testing-library/react": "16.3.0",
    "@types/react": "^19.1.1",
    "ci-info": "^4.4.0",
    "minimatch": "^10.0.3",
    "tsup": "^5.12.6",
    "vitest": "^4.0.18"
  },
  "babel": {
    "presets": [
      "@scm-manager/babel-preset"
    ]
  },
  "prettier": "@scm-manager/prettier-config",
  "eslintConfig": {
    "extends": "@scm-manager/eslint-config",
    "rules": {
      "@typescript-eslint/no-explicit-any": "off",
      "no-dupe-class-members": "off"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
